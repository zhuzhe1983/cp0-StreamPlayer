#!/bin/sh
set -eu

systemctl_command=${STREAMPLAYER_SYSTEMCTL_COMMAND:-/usr/bin/systemctl}
state_root=${STREAMPLAYER_RESOURCE_GUARD_STATE_DIR:-/run/streamplayer-resource-guard}
proc_root=${STREAMPLAYER_PROC_ROOT:-/proc}
background_state="${state_root}/background"
display_state="${state_root}/display"
streamplayer_executable=${STREAMPLAYER_EXECUTABLE:-/usr/share/APPLaunch/bin/M5CardputerZero-StreamPlayer}
restore_wait_seconds=${STREAMPLAYER_RESTORE_WAIT_SECONDS:-120}
guard_poll_seconds=${STREAMPLAYER_GUARD_POLL_SECONDS:-2}
tracked_pid=
tracked_starttime=
tracked_process_group=

case "${restore_wait_seconds}" in
    ''|*[!0-9]*) restore_wait_seconds=120 ;;
esac
case "${guard_poll_seconds}" in
    ''|0|*[!0-9]*) guard_poll_seconds=2 ;;
esac

process_executable_matches()
{
    process_id=$1
    executable=$(readlink "${proc_root}/${process_id}/exe" 2>/dev/null || true)
    case "${executable}" in
        "${streamplayer_executable}"|"${streamplayer_executable} (deleted)")
            return 0
            ;;
        *)
            return 1
            ;;
    esac
}

read_process_identity()
{
    process_id=$1
    stat_line=$(cat "${proc_root}/${process_id}/stat" 2>/dev/null) || return 1
    stat_fields=${stat_line##*) }
    [ "${stat_fields}" != "${stat_line}" ] || return 1
    set -- ${stat_fields}
    [ "$#" -ge 20 ] || return 1
    process_group=${3}
    starttime=${20}
    case "${process_group}:${starttime}" in
        *[!0-9:]*|:*) return 1 ;;
    esac
    printf '%s %s\n' "${starttime}" "${process_group}"
}

capture_streamplayer_process()
{
    newest_starttime=0
    newest_pid=0
    newest_process_group=0

    # Scan once at guard startup. The wait loop below follows only this
    # process identity instead of repeatedly walking every process in /proc.
    for process_dir in "${proc_root}"/[0-9]*; do
        [ -d "${process_dir}" ] || continue
        process_id=${process_dir##*/}
        process_executable_matches "${process_id}" || continue
        identity=$(read_process_identity "${process_id}") || continue
        starttime=${identity%% *}
        process_group=${identity#* }

        # Close the readlink/stat race before accepting the candidate.
        process_executable_matches "${process_id}" || continue
        if [ "${starttime}" -gt "${newest_starttime}" ] ||
           { [ "${starttime}" -eq "${newest_starttime}" ] &&
             [ "${process_id}" -gt "${newest_pid}" ]; }; then
            newest_pid=${process_id}
            newest_starttime=${starttime}
            newest_process_group=${process_group}
        fi
    done

    if [ "${newest_pid}" -eq 0 ]; then
        printf '%s\n' \
            "streamplayer: no exact StreamPlayer process found for resource guard" >&2
        return 1
    fi

    tracked_pid=${newest_pid}
    tracked_starttime=${newest_starttime}
    tracked_process_group=${newest_process_group}
    printf '%s\n' \
        "streamplayer: resource guard tracking pid=${tracked_pid} pgrp=${tracked_process_group}"
}

tracked_process_is_running()
{
    [ -n "${tracked_pid}" ] || return 1
    process_executable_matches "${tracked_pid}" || return 1
    identity=$(read_process_identity "${tracked_pid}") || return 1
    current_starttime=${identity%% *}
    current_process_group=${identity#* }
    [ "${current_starttime}" = "${tracked_starttime}" ] &&
        [ "${current_process_group}" = "${tracked_process_group}" ]
}

record_tracked_process()
{
    guard_state=$1
    printf '%s\n' "${tracked_pid}" > "${guard_state}/tracked-pid.tmp"
    printf '%s\n' "${tracked_starttime}" > "${guard_state}/tracked-starttime.tmp"
    printf '%s\n' "${tracked_process_group}" > "${guard_state}/tracked-pgrp.tmp"
    chmod 0644 \
        "${guard_state}/tracked-pid.tmp" \
        "${guard_state}/tracked-starttime.tmp" \
        "${guard_state}/tracked-pgrp.tmp"
    mv -- "${guard_state}/tracked-pid.tmp" "${guard_state}/tracked-pid"
    mv -- "${guard_state}/tracked-starttime.tmp" "${guard_state}/tracked-starttime"
    mv -- "${guard_state}/tracked-pgrp.tmp" "${guard_state}/tracked-pgrp"
}

wait_for_streamplayer_exit()
{
    while tracked_process_is_running; do
        sleep "${guard_poll_seconds}"
    done
}

start_and_wait_for_service()
{
    service_name=$1
    if ! "${systemctl_command}" --no-block start "${service_name}" >/dev/null 2>&1; then
        return 1
    fi

    waited_seconds=0
    while [ "${waited_seconds}" -lt "${restore_wait_seconds}" ]; do
        if "${systemctl_command}" is-active --quiet "${service_name}"; then
            return 0
        fi
        if "${systemctl_command}" is-failed --quiet "${service_name}"; then
            return 1
        fi
        sleep 1
        waited_seconds=$((waited_seconds + 1))
    done

    printf '%s\n' \
        "streamplayer: timed out restoring ${service_name} after ${restore_wait_seconds}s" >&2
    return 1
}

restore_background()
{
    [ -d "${background_state}" ] || return 0
    rm -f -- "${background_state}/ready" "${background_state}/ready.tmp"
    system_state=$("${systemctl_command}" is-system-running 2>/dev/null || true)
    if [ "${system_state}" = stopping ]; then
        rm -rf -- "${background_state}"
        rmdir "${state_root}" 2>/dev/null || true
        return 0
    fi
    restore_status=0

    if [ -f "${background_state}/masked-by-streamplayer" ]; then
        if ! "${systemctl_command}" unmask --runtime packagekit.service >/dev/null 2>&1; then
            restore_status=1
        fi
    fi
    if [ -f "${background_state}/was-active" ]; then
        if ! start_and_wait_for_service packagekit.service; then
            restore_status=1
        fi
    fi

    if [ "${restore_status}" -eq 0 ]; then
        rm -rf -- "${background_state}"
        rmdir "${state_root}" 2>/dev/null || true
    else
        printf '%s\n' "streamplayer: failed to restore PackageKit state" >&2
    fi
    return "${restore_status}"
}

acquire_background()
{
    if [ -d "${background_state}" ]; then
        rm -f -- "${background_state}/ready" "${background_state}/ready.tmp"
        restore_background
    fi
    tracked_process_is_running
    install -d -m 0755 "${background_state}"
    chmod 0755 "${state_root}" "${background_state}"
    record_tracked_process "${background_state}"

    if "${systemctl_command}" is-active --quiet packagekit.service; then
        : > "${background_state}/was-active"
    fi
    load_state=$("${systemctl_command}" show packagekit.service \
        --property=LoadState --value 2>/dev/null || true)
    if [ "${load_state}" != masked ]; then
        : > "${background_state}/masked-by-streamplayer"
        if ! "${systemctl_command}" mask --runtime packagekit.service >/dev/null; then
            printf '%s\n' "streamplayer: failed to mask PackageKit" >&2
            return 1
        fi
    fi
    "${systemctl_command}" stop packagekit.service >/dev/null
    if "${systemctl_command}" is-active --quiet packagekit.service; then
        printf '%s\n' "streamplayer: PackageKit remained active" >&2
        return 1
    fi
    : > "${background_state}/ready.tmp"
    mv -- "${background_state}/ready.tmp" "${background_state}/ready"
}

restore_display()
{
    [ -d "${display_state}" ] || return 0
    rm -f -- "${display_state}/ready" "${display_state}/ready.tmp"
    system_state=$("${systemctl_command}" is-system-running 2>/dev/null || true)
    if [ "${system_state}" = stopping ]; then
        rm -rf -- "${display_state}"
        rmdir "${state_root}" 2>/dev/null || true
        return 0
    fi
    restore_status=0

    if [ -f "${display_state}/was-active" ]; then
        if ! start_and_wait_for_service lightdm.service; then
            restore_status=1
        fi
    fi

    if [ "${restore_status}" -eq 0 ]; then
        rm -rf -- "${display_state}"
        rmdir "${state_root}" 2>/dev/null || true
    else
        printf '%s\n' "streamplayer: failed to restore LightDM state" >&2
    fi
    return "${restore_status}"
}

acquire_display()
{
    if [ -d "${display_state}" ]; then
        rm -f -- "${display_state}/ready" "${display_state}/ready.tmp"
        restore_display
    fi
    tracked_process_is_running
    install -d -m 0755 "${display_state}"
    chmod 0755 "${state_root}" "${display_state}"
    record_tracked_process "${display_state}"

    if "${systemctl_command}" is-active --quiet lightdm.service; then
        : > "${display_state}/was-active"
    fi
    "${systemctl_command}" stop lightdm.service >/dev/null
    if "${systemctl_command}" is-active --quiet lightdm.service; then
        printf '%s\n' "streamplayer: LightDM remained active" >&2
        return 1
    fi
    : > "${display_state}/ready.tmp"
    mv -- "${display_state}/ready.tmp" "${display_state}/ready"
}

case "${1:-}" in
    background)
        capture_streamplayer_process
        acquire_background
        wait_for_streamplayer_exit
        ;;
    restore-background)
        restore_background
        ;;
    display)
        capture_streamplayer_process
        acquire_display
        wait_for_streamplayer_exit
        ;;
    restore-display)
        restore_display
        ;;
    *)
        printf '%s\n' \
            "usage: $0 {background|restore-background|display|restore-display}" >&2
        exit 2
        ;;
esac

exit 0
