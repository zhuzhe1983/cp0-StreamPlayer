#!/bin/sh
set -eu

for required_font in \
    /usr/share/APPLaunch/share/font/NotoSansSC-Regular.ttf \
    /usr/share/fonts/truetype/dejavu/DejaVuSans.ttf; do
    if [ ! -r "${required_font}" ] || [ ! -s "${required_font}" ]; then
        printf '%s\n' "streamplayer: missing required Unicode font: ${required_font}" >&2
        exit 1
    fi
done

for required_command in \
    curl \
    gst-launch-1.0 \
    gst-inspect-1.0 \
    amixer \
    wlr-randr \
    sudo; do
    if ! command -v "${required_command}" >/dev/null 2>&1; then
        printf '%s\n' "streamplayer: missing required command: ${required_command}" >&2
        exit 1
    fi
done

if ! command -v iw >/dev/null 2>&1 && [ ! -x /usr/sbin/iw ]; then
    printf '%s\n' "streamplayer: missing required command: iw" >&2
    exit 1
fi

for required_element in \
    playbin \
    v4l2h264dec \
    kmssink \
    fbdevsink \
    alsasink; do
    if ! gst-inspect-1.0 "${required_element}" >/dev/null 2>&1; then
        printf '%s\n' "streamplayer: missing GStreamer element: ${required_element}" >&2
        exit 1
    fi
done

decoder_found=false
decoder_device=
for name_file in /sys/class/video4linux/video*/name; do
    [ -f "${name_file}" ] || continue
    if grep -Eqi 'decode|decoder' "${name_file}"; then
        decoder_found=true
        decoder_device="/dev/$(basename "$(dirname "${name_file}")")"
        break
    fi
done
if [ "${decoder_found}" != true ]; then
    printf '%s\n' "streamplayer: no V4L2 hardware decoder device was found" >&2
    exit 1
fi
if [ ! -r "${decoder_device}" ] || [ ! -w "${decoder_device}" ]; then
    printf '%s\n' "streamplayer: hardware decoder is not accessible: ${decoder_device}" >&2
    exit 1
fi

if [ ! -r /dev/dri/card0 ] || [ ! -w /dev/dri/card0 ]; then
    printf '%s\n' "streamplayer: /dev/dri/card0 is missing or inaccessible" >&2
    exit 1
fi

lcd_fb_number=$(awk '/fb_st7789|panel-mipi-dbi|st7789/ { print $1; exit }' /proc/fb 2>/dev/null)
if [ -z "${lcd_fb_number}" ]; then
    printf '%s\n' "streamplayer: CardputerZero LCD framebuffer was not found" >&2
    exit 1
fi
if [ ! -r "/dev/fb${lcd_fb_number}" ] || [ ! -w "/dev/fb${lcd_fb_number}" ]; then
    printf '%s\n' "streamplayer: LCD framebuffer is not accessible: /dev/fb${lcd_fb_number}" >&2
    exit 1
fi

for allowed_guard_command in \
    "start streamplayer-background-guard.service" \
    "start streamplayer-display-guard.service"; do
    if ! sudo -n -l /usr/bin/systemctl ${allowed_guard_command} >/dev/null 2>&1; then
        printf '%s\n' \
            "streamplayer: missing guard permission: systemctl ${allowed_guard_command}" >&2
        exit 1
    fi
done

printf '%s\n' "streamplayer: runtime dependencies and hardware devices are available"
exit 0
