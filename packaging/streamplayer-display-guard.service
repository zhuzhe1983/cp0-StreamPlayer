[Unit]
Description=StreamPlayer exclusive display guard
# Do not order this unit against LightDM: ExecStopPost starts LightDM while
# this unit is still stopping, and an ordering edge would deadlock that job.

[Service]
Type=exec
ExecStart=/usr/lib/streamplayer/resource-guard display
ExecStopPost=/usr/lib/streamplayer/resource-guard restore-display
Restart=no
OOMPolicy=stop
TimeoutStopSec=150s
