#!/bin/sh
set -e

if [ "${1:-}" = remove ]; then
    for executable_link in /proc/[0-9]*/exe; do
        [ -L "${executable_link}" ] || continue
        executable=$(readlink "${executable_link}" 2>/dev/null || true)
        case "${executable}" in
            /usr/share/APPLaunch/bin/M5CardputerZero-StreamPlayer|\
            "/usr/share/APPLaunch/bin/M5CardputerZero-StreamPlayer (deleted)")
                printf '%s\n' \
                    "streamplayer: exit StreamPlayer before removing the package" >&2
                exit 1
                ;;
        esac
    done

    restore_status=0

    if command -v systemctl >/dev/null 2>&1; then
        if ! systemctl stop streamplayer-display-guard.service >/dev/null 2>&1; then
            printf '%s\n' "streamplayer: failed to restore the display service" >&2
            restore_status=1
        fi
        if ! systemctl stop streamplayer-background-guard.service >/dev/null 2>&1; then
            printf '%s\n' "streamplayer: failed to restore the package service" >&2
            restore_status=1
        fi
        if ! systemctl disable --now streamplayer-tuning.service >/dev/null 2>&1; then
            printf '%s\n' "streamplayer: failed to disable runtime tuning" >&2
            restore_status=1
        fi
    fi

    if [ -x /usr/lib/streamplayer/resource-guard ]; then
        if ! /usr/lib/streamplayer/resource-guard restore-display; then
            restore_status=1
        fi
        if ! /usr/lib/streamplayer/resource-guard restore-background; then
            restore_status=1
        fi
    fi

    if [ -x /usr/lib/streamplayer/apply-runtime-tuning ] &&
       ! /usr/lib/streamplayer/apply-runtime-tuning restore; then
        restore_status=1
    fi

    if [ -x /usr/lib/streamplayer/prepare-system ] &&
       ! /usr/lib/streamplayer/prepare-system restore; then
        restore_status=1
    fi

    if [ "${restore_status}" -ne 0 ]; then
        printf '%s\n' \
            "streamplayer: removal stopped so runtime settings can be restored safely" >&2
        exit "${restore_status}"
    fi
fi

exit 0
